{
	"name": "OpenProject",
	"version": "0.1.0",
	"author": [
		"Tobias Haider"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:OpenProject",
	"descriptionmsg": "openproject-desc",
	"license-name": "GPL",
	"type": "other",
	"AutoloadClasses": {
		"MediaWiki\\Extension\\OpenProject\\OpenProjectHooks": "src/Hooks.php",
		"MediaWiki\\Extension\\OpenProject\\ApiClose": "src/ApiClose.php",
		"MediaWiki\\Extension\\OpenProject\\ApiMove": "src/ApiMove.php"
	},
	"config": {
		"OpenProjectURL": false,
		"OpenProjectProjectID": false
	},
	"ExtensionMessagesFiles": {
		"OpenProjectMagic": "OpenProject.i18n.magic.php"
	},
	"Hooks": {
		"GetPreferences": [
			"MediaWiki\\Extension\\OpenProject\\OpenProjectHooks::onGetPreferences"
		],
		"ParserFirstCallInit": [
			"MediaWiki\\Extension\\OpenProject\\OpenProjectHooks::onParserFirstCallInit"
		],
		"BeforePageDisplay": [
			"MediaWiki\\Extension\\OpenProject\\OpenProjectHooks::onBeforePageDisplay"
		],
		"ResourceLoaderGetConfigVars": [
			"MediaWiki\\Extension\\OpenProject\\OpenProjectHooks::onResourceLoaderGetConfigVars"
		]
	},
	"MessagesDirs": {
		"OpenProject": [
			"i18n"
		]
	},
	"ResourceModules": {
		"ext.openproject": {
			"scripts": [
				"modules/ext.openproject.js"
			],
			"styles": [
				"modules/ext.openproject.css"
			],
			"messages": [
			],
			"dependencies": [ "mediawiki.api" ]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "OpenProject"
	},
	"APIModules": {
		"opclose": "MediaWiki\\Extension\\OpenProject\\ApiClose",
		"opmove": "MediaWiki\\Extension\\OpenProject\\ApiMove"
	},
	"manifest_version": 1
}
