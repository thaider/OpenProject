{
	"name": "OpenProject",
	"version": "0.0.1",
	"author": [
		"Tobias Haider"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:OpenProject",
	"descriptionmsg": "openproject-desc",
	"license-name": "GPL",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.36.0"
	},
	"AutoloadClasses": {
		"MediaWiki\\Extension\\OpenProject\\Hooks": "src/Hooks.php",
		"MediaWiki\\Extension\\OpenProject\\OpenProjectClient": "src/OpenProjectClient.php",
		"MediaWiki\\Extension\\OpenProject\\ApiOpenProjectClose": "src/ApiOpenProjectClose.php"
	},
	"APIModules": {
		"openproject-close": "MediaWiki\\Extension\\OpenProject\\ApiOpenProjectClose"
	},
	"config": {
		"OpenProjectURL": false,
		"OpenProjectProjectID": false,
		"OpenProjectClosedStatusID": 10
	},
	"ExtensionMessagesFiles": {
		"OpenProjectMagic": "OpenProject.i18n.magic.php"
	},
	"Hooks": {
		"GetPreferences": [
			"MediaWiki\\Extension\\OpenProject\\Hooks::onGetPreferences"
		],
		"ParserFirstCallInit": [
			"MediaWiki\\Extension\\OpenProject\\Hooks::onParserFirstCallInit"
		],
		"BeforePageDisplay": [
			"MediaWiki\\Extension\\OpenProject\\Hooks::onBeforePageDisplay"
		],
		"ResourceLoaderGetConfigVars": [
			"MediaWiki\\Extension\\OpenProject\\Hooks::onResourceLoaderGetConfigVars"
		]
	},
	"MessagesDirs": {
		"OpenProject": [
			"i18n"
		]
	},
	"ResourceModules": {
		"ext.openproject": {
			"dependencies": [
				"mediawiki.api"
			],
			"scripts": [
				"modules/ext.openproject.js"
			],
			"styles": [
				"modules/ext.openproject.css"
			],
			"messages": [
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "OpenProject"
	},
	"manifest_version": 1
}
